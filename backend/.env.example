# SQLite database file path. Defaults to backend/hiring_agent.db - only set
# this if you want the db file somewhere else.
# DATABASE_PATH=./hiring_agent.db

# Secret used to sign admin JWTs - change this to a random string.
JWT_SECRET_KEY=change-this-to-a-random-secret

# Hardcoded admin login (no signup flow, per the assignment).
ADMIN_EMAIL=admin@enter.in
ADMIN_PASSWORD=admin123
